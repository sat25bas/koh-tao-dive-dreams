# Generated by scripts/write-static-htaccess.cjs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  Options +FollowSymLinks -MultiViews

  # Keep API paths untouched (served externally via VITE_API_BASE_URL)
  RewriteRule ^api/ - [L]

  # Serve real files/folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback
  RewriteRule . index.html [L]
</IfModule>
